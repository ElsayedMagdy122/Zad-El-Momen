<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- 1. Background Art: Mosque Silhouette in Top-End Corner -->
    <ImageView
        android:id="@+id/iv_widget_mosque_bg"
        android:layout_width="140dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/ic_mosque_light_bg" />

    <!-- 2. Background Art: Mosque Column on the Start -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/mosque_column" />

    <!-- 3. Prayers Content Container -->
    <LinearLayout
        android:id="@+id/layout_prayers_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Header: Hijri Date on Start & Next Prayer Summary on End -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/header_hijri_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_small" />

                <TextView
                    android:id="@+id/tv_widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_next_prayer_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_header"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Prayers Row (5 Equal Columns) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- 1. Fajr -->
            <LinearLayout
                android:id="@+id/container_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_item_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_name_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ampm_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_indicator_fajr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_triangle_down"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 2. Dhuhr -->
            <LinearLayout
                android:id="@+id/container_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_item_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_name_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ampm_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_indicator_dhuhr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_triangle_down"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 3. Asr -->
            <LinearLayout
                android:id="@+id/container_asr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_item_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_name_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ampm_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_indicator_asr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_triangle_down"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 4. Maghrib -->
            <LinearLayout
                android:id="@+id/container_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_item_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_name_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ampm_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_indicator_maghrib"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_triangle_down"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 5. Isha -->
            <LinearLayout
                android:id="@+id/container_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/widget_item_normal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_name_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ampm_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_indicator_isha"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_triangle_down"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Empty State: Location Not Configured -->
    <LinearLayout
        android:id="@+id/layout_empty_location"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_location" />

        <TextView
            android:id="@+id/tv_widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
